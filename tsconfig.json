{
	"compilerOptions": {
		"baseUrl": "./",
		"rootDir": "./",
		"declaration": true,
		"declarationMap": true,

		"target": "esnext",
		"experimentalDecorators": true,
		"noEmit": true,
		"lib": ["dom", "dom.iterable", "esnext"],

		"strict": false,
		"downlevelIteration": true,
		"alwaysStrict": true,
		"incremental": true,

		"noImplicitOverride": false,
		"noImplicitThis": true,

		"noPropertyAccessFromIndexSignature": false,
		"strictFunctionTypes": false,
		"strictNullChecks": false,

		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"module": "ESNext",
		"moduleResolution": "bundler",

		"paths": {
			"@gramax/sdk": ["plugins/sdk/src/index.ts"],
			"@gramax/sdk/editor": ["plugins/sdk/src/editor/index.ts"],
			"@gramax/sdk/events": ["plugins/sdk/src/events/index.ts"],
			"@gramax/sdk/localization": ["plugins/sdk/src/localization/index.ts"],
			"@gramax/sdk/ui": ["plugins/sdk/src/ui/index.ts"],
			"@gramax/sdk/utilities": ["plugins/sdk/src/utilities/index.ts"],
			"@app/resolveModule": ["app/resolveModule/index.ts"],
			"ics-ui-kit/*": ["node_modules/ics-ui-kit/dist/*"],
			"@components/*": ["core/components/*"],
			"@ui-kit/hooks/*": ["core/ui-kit/hooks/*"],
			"@ui-kit/*": ["core/ui-kit/components/*"],
			"@dynamicImports/*": ["core/dynamicImports/*"],
			"@ext/*": ["core/extensions/*"],
			"@core/*": ["core/logic/*"],
			"@plugins/*": ["core/plugins/*"],
			"@core-ui/*": ["core/ui-logic/*"],
			"@app/*": ["app/*"],
			"@app-plugins/git": ["apps/tauri/plugins/plugin-gramax-git/webview-src"]
		},

		"importHelpers": true,
		"importsNotUsedAsValues": "remove",

		"newLine": "crlf",
		"removeComments": true,
		"forceConsistentCasingInFileNames": true,
		"preserveSymlinks": true,

		"jsx": "preserve",
		"allowJs": true,
		"checkJs": false
	},

	"include": ["./app/**/*", "./core/**/*", "./apps/**/*", "./services/**/*", "./scripts/**/*", "./**/*.config.ts"],

	"exclude": [
		"target",
		"**/node_modules",
		"node_modules",
		"dist",
		"**/dist",
		".npm",
		"**/.npm",
		".next",
		"**/.next",
		".vite-cache",
		"**/.vite-cache",
		".git",
		"./e2e-pw",
		"apps/tauri/src-tauri",
		"gx",
		"**/build",
		"apps/next/tsconfig.json",
		"apps/docportal/tsconfig.json"
	]
}
